{
  "name": "better-unraid-mcp",
  "mcpName": "io.github.mswdev/better-unraid-mcp",
  "version": "0.1.0",
  "description": "A complete, maintained Model Context Protocol server for the Unraid GraphQL API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mswdev/better-unraid-mcp.git"
  },
  "homepage": "https://github.com/mswdev/better-unraid-mcp#readme",
  "bugs": "https://github.com/mswdev/better-unraid-mcp/issues",
  "author": "Matt White (mswdev)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "better-unraid-mcp": "dist/index.js"
  },
  "files": ["dist", "schema"],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "generate": "graphql-codegen --config codegen.ts",
    "schema:update": "node scripts/update-schema.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build && npm test && npm run lint",
    "build:mcpb": "node scripts/build-mcpb.mjs"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "graphql": "^17.0.2",
    "graphql-ws": "^6.2.1",
    "pino": "^9.14.0",
    "ssh2": "^1.17.0",
    "undici": "^6.26.0",
    "ws": "^8.21.3",
    "zod": "^4.2.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@graphql-codegen/cli": "^7.1.1",
    "@graphql-codegen/typed-document-node": "^7.0.2",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-codegen/typescript-operations": "^6.0.3",
    "@types/node": "^22.19.19",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
